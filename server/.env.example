# Server network settings
PORT=3000
NODE_ENV=production
PUBLIC_BASE_URL=https://api.your-domain.example
JWT_SECRET=replace-with-a-long-random-secret

# Current local-development storage. These are not used after the Supabase
# adapter is enabled, but preserve the working offline development mode.
DB_PATH=./database.db
UPLOAD_DIR=./uploads
MAX_IMAGE_BYTES=5242880
STALE_SOS_HOURS=6
PUSH_ENABLED=true

# Supabase server-only credentials. Never copy SUPABASE_SERVICE_ROLE_KEY to
# app/.env or app.json.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_STORAGE_BUCKET=sos-media
